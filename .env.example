# Copy this file to .env and generate new local values. Never commit .env.
# Required secrets have no defaults.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Optional Google OpenID Connect web client. Set both or neither. Use a
# separate client per environment; never commit a real client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional invitation email; disabled until provider/From/pilot are authorized.
# Credentials and independent 32-byte hex encryption key stay private.
ISSOPEN_MAIL_TRANSPORT=disabled
ISSOPEN_SMTP_HOST=
ISSOPEN_SMTP_PORT=587
ISSOPEN_SMTP_SECURE=false
ISSOPEN_SMTP_USER=
ISSOPEN_SMTP_PASSWORD=
ISSOPEN_MAIL_FROM=
ISSOPEN_MAIL_ENCRYPTION_KEY=

# Non-secret local settings.
POSTGRES_USER=issopen
POSTGRES_DB=issopen
ISSOPEN_PORT=8080
ISSOPEN_BASE_URL=http://localhost:8080
ISSOPEN_TRUSTED_ORIGINS=
NODE_ENV=development
