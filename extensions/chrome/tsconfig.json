{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "exclude": ["node_modules", ".output"]
}
