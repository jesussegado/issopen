{
  "name": "issopen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.2d77a82c5b594c401126ad511928b430bf11cfa3f22d94f3f7742d5ec46c3b8aa9cd88b1b1593672f4c7df49bce4c20788ed94bcdd0796f40a30e62e0b8c6f3f",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && vite build && tsc -p tsconfig.build.json",
    "start": "node dist/runtime/src/server/index.js",
    "lint": "biome check --files-ignore-unknown=true --indent-style=space --css-parse-tailwind-directives=true package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json vite.config.ts drizzle.config.ts src scripts skills tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root . --exclude 'tests/integration/**' --exclude 'tests/compose/**' --exclude 'tests/e2e/**' --exclude 'dist/**' --passWithNoTests",
    "test:web": "vitest run --root . tests/web --exclude 'dist/**'",
    "test:e2e": "pnpm build && playwright test",
    "e2e:serve": "tsx tests/e2e/server.ts",
    "test:integration": "vitest run --root . tests/integration --exclude 'dist/**' --passWithNoTests",
    "test:compose": "vitest run --root . tests/compose --exclude 'dist/**' --passWithNoTests",
    "test:secrets": "tsx scripts/check-secrets.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:e2e && pnpm test:secrets",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "owner": "tsx scripts/owner.ts",
    "dogfood": "tsx scripts/dogfood.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@node-rs/argon2": "2.2.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "jose": "6.1.3",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
